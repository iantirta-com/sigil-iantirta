# Please note that this Dockerfile is used for testing nightly builds and should
# not be used to deploy Sigil
FROM debian:trixie
LABEL maintainer="iantirta.com <info@iantirta.com>"

ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8

RUN dpkg --add-architecture i386

RUN apt-get update \
    && apt-get install -y curl unzip 7zip-standalone wine \
    && rm -rf /var/lib/apt/lists/*

USER sigil

ARG DRIVE_C_DIR=/var/lib/sigil/.wine/drive_c
ARG SIGIL_BUILD_DIR=${DRIVE_C_DIR}/sigilbuild
# pre-create directories and link sigil sources to their mount point
RUN mkdir -pm755 ${DRIVE_C_DIR} ${SIGIL_BUILD_DIR}/nssm-2.24 ${SIGIL_BUILD_DIR}/vcredist ${SIGIL_BUILD_DIR}/WinPy64 ${SIGIL_BUILD_DIR}/wkhtmltopdf \
    && ln -s /data/src ${SIGIL_BUILD_DIR}/server

# Ignoring debug and fixme's message when running wine
ENV WINEDEBUG=-all

ARG NSIS_VERSION=3.12

ARG NSIS_URL=https://sourceforge.net/projects/nsis/files/NSIS%203/${NSIS_VERSION}/nsis-${NSIS_VERSION}.zip
RUN curl -sSL ${NSIS_URL} -o /tmp/nsis.zip \
    && unzip /tmp/nsis.zip -d ${DRIVE_C_DIR} \
    && mv ${DRIVE_C_DIR}/nsis-${NSIS_VERSION} ${DRIVE_C_DIR}/nsis \
    && rm /tmp/nsis.zip

ARG NSIS_PLUG_CURL=https://github.com/negrutiu/nsis-nscurl/releases/download/v25.3.12.183/NScurl.zip
RUN curl -sSL ${NSIS_PLUG_CURL} -o /tmp/nsis_curl.zip \
    && unzip /tmp/nsis_curl.zip Plugins/* -d ${DRIVE_C_DIR}/nsis/ \
    && rm /tmp/nsis_curl.zip

ARG NSIS_PLUG_ACCESS=https://nsis.sourceforge.io/mediawiki/images/4/4a/AccessControl.zip
RUN curl -sSL ${NSIS_PLUG_ACCESS} -o /tmp/nsis_access.zip \
        && unzip /tmp/nsis_access.zip Plugins/* -d ${DRIVE_C_DIR}/nsis/ \
        && mv ${DRIVE_C_DIR}/nsis/Plugins/i386-unicode/* ${DRIVE_C_DIR}/nsis/Plugins/x86-unicode/ \
        && mv ${DRIVE_C_DIR}/nsis/Plugins/i386-ansi/* ${DRIVE_C_DIR}/nsis/Plugins/x86-ansi/ \
        && rm /tmp/nsis_access.zip

ARG NSIS_PLUG_UNZIP=https://nsis.sourceforge.io/mediawiki/images/5/5a/NSISunzU.zip
RUN curl -sSL ${NSIS_PLUG_UNZIP} -o /tmp/nsis_unzip.zip \
        && unzip -j /tmp/nsis_unzip.zip NSISunzU/Plugin*/* -d ${DRIVE_C_DIR}/nsis/Plugins/x86-unicode/ \
        && rm /tmp/nsis_unzip.zip

ARG NSIS_PLUG_7Z=https://nsis.sourceforge.io/mediawiki/images/6/69/Nsis7z_19.00.7z
RUN curl -sSL ${NSIS_PLUG_7Z} -o /tmp/nsis_7z.7z \
    && 7zz x /tmp/nsis_7z.7z -o/tmp/nsis_7z_extracted 'Plugins/x86-unicode/*' 'Plugins/x86-ansi/*' \
    && cp -r /tmp/nsis_7z_extracted/Plugins/x86-unicode/* ${DRIVE_C_DIR}/nsis/Plugins/x86-unicode/ \
    && cp -r /tmp/nsis_7z_extracted/Plugins/x86-ansi/* ${DRIVE_C_DIR}/nsis/Plugins/x86-ansi/ \
    && rm -rf /tmp/nsis_7z*

ARG WINPY=7.5.20240410final/Winpython64-3.12.3.0dot.exe
RUN curl -sSL https://github.com/winpython/winpython/releases/download/${WINPY} -o /tmp/winpydot.exe \
    && 7zz x /tmp/winpydot.exe -o${SIGIL_BUILD_DIR} \
    && mv ${SIGIL_BUILD_DIR}/WPy64*/* ${SIGIL_BUILD_DIR}/WinPy64/ \
    && rmdir ${SIGIL_BUILD_DIR}/WPy64* \
    && rm /tmp/winpydot.exe

RUN curl -sSL https://nssm.cc/release/nssm-2.24.zip -o /tmp/nssm.zip \
    && unzip /tmp/nssm.zip -d ${SIGIL_BUILD_DIR} \
    && rm /tmp/nssm.zip

ARG WKHTMLTOPDF_URL=https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6-1/wkhtmltox-0.12.6-1.msvc2015-win64.exe
RUN curl ${WKHTMLTOPDF_URL} -sSL  -o/tmp/wkhtml_installer.exe \
    && echo '1efcfaf8472871268fd399865a3e62b435b91d4413009b80830eaaff7a57d088 /tmp/wkhtml_installer.exe' | sha256sum -c \
    && 7zz e /tmp/wkhtml_installer.exe bin/wkhtmltopdf.exe -o${SIGIL_BUILD_DIR}/wkhtmltopdf/ \
    && rm /tmp/wkhtml_installer.exe

ADD --chown=sigil:sigil \
    https://download.microsoft.com/download/9/3/F/93FCF1E7-E6A4-478B-96E7-D4B285925B00/vc_redist.x64.exe \
    ${SIGIL_BUILD_DIR}/vcredist/

# Pre install requirements
ADD --chown=sigil:sigil requirements*.txt ${DRIVE_C_DIR}/
ADD --chown=sigil:sigil https://nightly.iantirta.com/wheels/netifaces-0.11.0-cp312-cp312-win_amd64.whl ${DRIVE_C_DIR}
RUN wine ${SIGIL_BUILD_DIR}/WinPy64/python-3.12.3.amd64/python.exe -m pip install --upgrade pip \
    && wine ${SIGIL_BUILD_DIR}/WinPy64/python-3.12.3.amd64/python.exe -m pip install "c:\netifaces-0.11.0-cp312-cp312-win_amd64.whl" \
    && cat ${DRIVE_C_DIR}/requirements*.txt | awk -F '#' '{if ($1) print $1}' | while read PACKAGE ; do \
    echo "${PACKAGE}" ; wine ${SIGIL_BUILD_DIR}/WinPy64/python-3.12.3.amd64/python.exe -m pip install "${PACKAGE}" ; \
    done \
    && wine ${SIGIL_BUILD_DIR}/WinPy64/python-3.12.3.amd64/python.exe -m pip install phonenumbers dbfread google-auth paramiko pdfminer.six pyjwt
