<?xml version="1.0" encoding="UTF-8"?>
<sigil>
    <data>
        <record id="view_partner_form" model="ir.ui.view">
            <field name="name">res.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[hasclass('mb8')]" position="replace">
                    <div class="mb8">
                        <div class="d-flex gap-3">
                            <div class="d-flex flex-column">
                                <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128', 'size': [130,130], 'img_class': 'rounded border'}"/>
                                <field name="avatar_128" invisible="1"/> <!-- Needed in contact_image widget -->
                                <field name="company_type" widget="radio" options="{'horizontal': false}"/>
                            </div>
                            <div class="d-flex flex-column flex-md-row gap-2 flex-grow-1">
                                <div class="d-flex flex-column flex-grow-1 gap-2">
                                    <h5 class="mb-0">
                                        <label for="name"/>
                                        <field class="text-break d-block" name="name" default_focus="1" placeholder="e.g. Lumber Inc" invisible="not is_company" required="type == 'contact'"/>
                                        <field class="text-break d-block" name="name" default_focus="1" placeholder="e.g. Brandon Freeman" invisible="is_company" required="type == 'contact'"/>
                                    </h5>
                                    <h5 class="mb-0">
                                        <span>
                                            <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                            <label for="email"/>
                                        </span>
                                        <field name="email" class="w-100" widget="email" required="user_ids" placeholder="Email"/>
                                    </h5>
                                </div>
                                <div class="d-flex flex-column flex-grow-1 gap-2">
                                    <h5 class="mb-0">
                                        <span>
                                            <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                            <label for="phone"/>
                                        </span>
                                        <field name="phone" class="w-100" widget="phone" placeholder="Phone"/>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</sigil>