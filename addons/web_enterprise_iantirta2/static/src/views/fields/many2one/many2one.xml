<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.Many2One" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_field_many2one_extra')]" position="replace">
            <div class="ie_field_many2one_extra">
                <div class="o_field_many2one_extra mt-1 o_input">
                    <t t-foreach="lines" t-as="line" t-key="line_index">
                        <div t-esc="line" t-att-title="line"  class="text-truncate"/>
                    </t>
                </div>
                <!-- Mock Button width -->
                <t t-if="hasLinkButton">
                    <button class="invisible o_external_button btn btn-link text-action px-1">
                        <i class="oi" t-att-class="env.inDialog ? 'oi-launch' : 'oi-arrow-right'"/>
                    </button>
                </t>
                <t t-if="hasBarcodeButton">
                    <button class="invisible btn ms-3 o_barcode"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>