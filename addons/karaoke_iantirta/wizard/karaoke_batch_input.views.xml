<?xml version="1.0" encoding="UTF-8"?>
<sigil>
    <record id="karaoke_batch_input_wizard_action" model="ir.actions.act_window">
        <field name="name">Karaoke Batch Input</field>
        <field name="res_model">karaoke.batch.input.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="karaoke_batch_input_wizard_view_form" model="ir.ui.view">
        <field name="name">karaoke.batch.input.wizard.view.form</field>
        <field name="model">karaoke.batch.input.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Karaoke Tasks">
                <sheet>
                    <p class="text-muted">
                        Create multiple karaoke tasks from YouTube links
                    </p>
                    <separator/>
                    <group>
                        <group colspan="2">
                            <field name="youtube_urls" class="mb-0" string="Sources" placeholder="Paste YouTube links here..."/>
                            <div class="text-muted small">
                                Separate multiple links with commas or semicolons.
                            </div>
                            <field name="karaoke_type" string="Karaoke Type" widget="radio" options="{'horizontal': '1'}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_on_click_create"
                        string="Create Tasks"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</sigil>