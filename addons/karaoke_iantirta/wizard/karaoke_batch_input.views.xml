<?xml version="1.0" encoding="UTF-8"?>
<sigil>
    <record id="karaoke_batch_input_wizard_action" model="ir.actions.act_window">
        <field name="name">Karaoke Batch Input</field>
        <field name="res_model">karaoke.batch.input.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="karaoke_batch_input_wizard_view_form" model="ir.ui.view">
        <field name="name">karaoke.batch.input.wizard.view.form</field>
        <field name="model">karaoke.batch.input.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group colspan="2">
                            <field name="youtube_urls" placeholder="Multiple urls, splitted by (,)."/>
                        </group>
                        <field name="karaoke_type" placeholder="Generation Type"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_on_click_create" string="Create" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</sigil>