<?xml version="1.0" encoding="UTF-8"?>
<sigil>

    <record id="gpu_worker_view_form" model="ir.ui.view">
        <field name="name">gpu.worker.form</field>
        <field name="model">gpu.worker</field>
        <field name="arch" type="xml">
            <form string="GPU Worker" duplicate="false">
                <header>
                    <button string="Refresh Quota" type="object" class="btn-secondary"
                        name="action_get_quotas" />
                    <button string="Start Worker" type="object" class="btn-primary"
                        invisible="status == 'running'" name="action_run" />
                    <field name="status" widget="statusbar" statusbar_visible="ready,running,error" />
                </header>
                <sheet>
                    <separator string="Worker" style="margin-top: 0 !important; margin-bottom: 0 !important;"/>
                    <div class="small mb-3 text-muted">Remote compute Configuration</div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="notebook_id"/>
                            <field name="access_token" password="true"/>
                        </group>
                        <group>
                            <field name="provider"/>
                        </group>
                    </group>
                </sheet>
                <sheet>
                    <notebook>
                        <page string="Quotas">
                            <field name="quota_json" />
                        </page>
                        <page string="Storage">
                            <div class="d-flex">
                                <div class="col-7 col-sm-6 col-lg-3 d-flex flex-column">
                                    <span class="o_form_label">
                                        Drive Root Folder ID
                                    </span>
                                    <span class="text-muted small">
                                        Root folder destination.
                                    </span>
                                </div>
                                <field name="gdrive_root_folder_id" class="w-100 h-100 my-auto"/>
                            </div>
                            <div class="d-md-flex mt-3">
                                <div class="w-md-50 w-lg-25 d-flex flex-column">
                                    <label for="gdrive_credentials" string="Credentials" class="o_form_label"/>
                                    <span class="text-muted small">
                                        Service Account Credentials
                                    </span>
                                    <field name="gdrive_credentials"
                                        widget="binary"
                                        class="o_field_binary_hide_download"
                                        options="{'accepted_file_extensions': '.json'}" />
                                </div>
                                <div class="w-md-50 w-lg-75 d-flex flex-column my-auto">
                                    <field name="gdrive_client_config" widget="text" class="w-100" />
                                </div>
                            </div>
                            <div invisible="not gdrive_client_config" class="d-md-flex mt-3">
                                <div class="w-md-50 w-lg-25  d-flex flex-column">
                                    <label for="gdrive_access_token_json" string="User Token" class="o_form_label"/>
                                    <span class="text-muted">
                                        User specific token.
                                    </span>
                                </div>
                                <div class="w-md-50 w-lg-75 d-flex flex-column my-auto">
                                    <field name="gdrive_access_token_json" widget="text" class="w-100"/>
                                    <div>
                                        <button invisible="not gdrive_access_token_json" name="action_setup_user_token" type="object" string="Refresh Token" class="btn btn-secondary h-100"/>
                                        <button invisible="gdrive_access_token_json" name="action_setup_user_token" type="object" string="Setup User Token" class="btn btn-secondary h-100"/>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="Log">
                            <field name="log" widget="logger"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="worker_notebook_view_form" model="ir.ui.view">
        <field name="name">worker.notebook.form</field>
        <field name="model">worker.notebook</field>
        <field name="arch" type="xml">
            <form string="Jupyter Notebook" duplicate="false">
                <sheet>
                    <group>
                        <group colspan="2">
                            <field name="name" />
                            <field name="language" />
                        </group>
                        <field name="code" widget="code" options="{'mode': 'python'}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gpu_worker_action" model="ir.actions.act_window">
        <field name="name">GPU Worker</field>
        <field name="res_model">gpu.worker</field>
        <field name="path">gpu-worker</field>
        <field name='view_mode'>list,kanban,form</field>
    </record>

    <record id="worker_notebook_action" model="ir.actions.act_window">
        <field name="name">Jupyter Notebook</field>
        <field name="res_model">worker.notebook</field>
        <field name="path">gpu-worker-notebook</field>
        <field name='view_mode'>list,form</field>
    </record>

    <menuitem
        id="gpu_worker"
        name="GPU Worker"
        parent="karaoke_root">

        <menuitem id="gpu_worker_worker" name="Worker" action="gpu_worker_action" />
        <menuitem id="worker_notebook" name="Notebook" action="worker_notebook_action" />

    </menuitem>
</sigil>