<?xml version="1.0" encoding="UTF-8"?>
<sigil>

    <record id="gpu_worker_view_form" model="ir.ui.view">
        <field name="name">gpu.worker.form</field>
        <field name="model">gpu.worker</field>
        <field name="arch" type="xml">
            <form string="GPU Worker" duplicate="false">
                <header>
                    <button string="Refresh Quota" type="object" class="btn-secondary"
                        name="action_get_quotas" />
                    <button string="Start Worker" type="object" class="btn-primary"
                        invisible="run_state == 'running'" name="action_run" />
                    <field name="run_state" widget="statusbar" statusbar_visible="ready,running,error" />
                </header>
                <sheet>
                    <separator string="Worker" style="margin-top: 0 !important; margin-bottom: 0 !important;"/>
                    <div class="small mb-3 text-muted">Remote compute Configuration</div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="notebook_id"/>
                            <div invisible='code != "colab"' class="d-md-flex mt-3">
                                <div class="w-md-50 w-lg-25 d-flex flex-column">
                                    <label for="google_client_secrets" string="Credentials" class="o_form_label"/>
                                    <span class="text-muted small">
                                        Client Config Credentials
                                    </span>
                                    <field name="google_client_secrets"
                                        widget="binary"
                                        class="o_field_binary_hide_download"
                                        options="{'accepted_file_extensions': '.json'}" />
                                </div>
                                <div class="w-md-50 w-lg-75 d-flex flex-column my-auto">
                                    <field name="google_client_secrets_json" widget="text" class="w-100" />
                                </div>
                            </div>
                            <field name="access_token" password="0" invisible="code != 'colab'" widget="text"/>
                            <field name="access_token" password="1" invisible="code == 'colab'"/>
                            <div invisible='code != "colab"' class="w-md-50 w-lg-75 d-flex flex-column my-auto">
                                <div>
                                    <button invisible="not access_token" name="action_setup_user_token" type="object" string="Refresh Token" class="btn btn-secondary h-100"/>
                                    <button invisible="access_token" name="action_setup_user_token" type="object" string="Setup User Token" class="btn btn-secondary h-100"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name='storage_id'/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quotas">
                            <group>
                                <group colspan="2">
                                    <field name="quota_used" invisible="1"/>
                                    <field name="quota_allowed" widget="progressbar" string='Quota Usage' options="{'current_value': 'quota_used', 'max_value': 'quota_allowed'}"/>
                                    <field string="Next Refill Time" name="quota_refresh_time"/>

                                    <!-- <field nolabel='1' name="quota_json" widget="worker_quota"/> -->
                                    <field name="last_heartbeat"/>
                                </group>
                            </group>
                        </page>
                        <page string="Log and Debug">
                            <group>
                                <group colspan="2">
                                    <field name="log_entry_ids">
                                        <list string="Log Entries">
                                            <field name='create_uid'/>
                                            <field name='create_date'/>
                                            <field name='name'/>
                                            <field name='level'/>
                                            <field name="message"/>
                                            <field name='path'/>
                                            <field name='line'/>
                                            <field name='func'/>
                                        </list>
                                    </field>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gpu_worker_view_tree" model="ir.ui.view">
        <field name="name">gpu.worker.tree</field>
        <field name="model">gpu.worker</field>
        <field name="arch" type="xml">
            <list string="GPU Worker">
                <field name="name"/>
                <field name='code'/>
                <field name="is_available"/>
                <field name='run_state' widget="badge"
                    decoration-success="run_state == 'ready'"
                    decoration-info="run_state == 'running'"
                    decoration-warning="run_state == 'starting_up'"
                    decoration-danger="run_state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="worker_notebook_view_form" model="ir.ui.view">
        <field name="name">worker.notebook.form</field>
        <field name="model">worker.notebook</field>
        <field name="arch" type="xml">
            <form string="Jupyter Notebook" duplicate="false">
                <sheet>
                    <group>
                        <group colspan="2">
                            <field name="name" />
                            <field name="language" />
                        </group>
                        <field name="code" widget="code" options="{'mode': 'python'}" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gpu_worker_action" model="ir.actions.act_window">
        <field name="name">GPU Worker</field>
        <field name="res_model">gpu.worker</field>
        <field name="path">gpu-worker</field>
        <field name='view_mode'>list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage karaoke GPU Worker
            </p>
        </field>
    </record>

    <record id="worker_notebook_action" model="ir.actions.act_window">
        <field name="name">Jupyter Notebook</field>
        <field name="res_model">worker.notebook</field>
        <field name="path">gpu-worker-notebook</field>
        <field name='view_mode'>list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage karaoke GPU Worker Notebook
            </p>
        </field>
    </record>

    <menuitem
        id="gpu_worker"
        name="GPU Worker"
        parent="karaoke_root">

        <menuitem id="gpu_worker_worker" name="Worker" action="gpu_worker_action" />
        <menuitem id="worker_notebook" name="Notebook" action="worker_notebook_action" />

    </menuitem>
</sigil>