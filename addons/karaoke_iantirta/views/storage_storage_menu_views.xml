<?xml version="1.0" encoding="UTF-8"?>
<sigil>

    <record id="view_cloud_storage_form" model="ir.ui.view">
        <field name="name">cloud.storage.form</field>
        <field name="model">iantirta.cloud.storage</field>
        <field name="arch" type="xml">
            <form string="Cloud Storage">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. My Personal Storage"/>
                            <field name='code'/>
                            <field name='storage_endpoint'/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Configuration">
                            <group name="provider_settings">
                                <group colspan="2">
                                    <field invisible='code != "gdrive"' name="gdrive_root_folder_id" class="w-100 h-100 my-auto"/>
                                    <field invisible='code != "hf_dataset"' name='hf_repo_id'/>
                                    <div invisible='code != "gdrive"' class="d-md-flex mt-3">
                                        <div class="w-md-50 w-lg-25 d-flex flex-column">
                                            <label for="google_client_secrets" string="Credentials" class="o_form_label"/>
                                            <span class="text-muted small">
                                                Client Config Credentials
                                            </span>
                                            <field name="google_client_secrets"
                                                widget="binary"
                                                class="o_field_binary_hide_download"
                                                options="{'accepted_file_extensions': '.json'}" />
                                        </div>
                                        <div class="w-md-50 w-lg-75 d-flex flex-column my-auto">
                                            <field name="google_client_secrets_json" widget="text" class="w-100" />
                                        </div>
                                    </div>
                                    <field name="access_token" password="0" invisible="code != 'gdrive'" widget="text"/>
                                    <field name="access_token" password="1" invisible="code == 'gdrive'"/>
                                    <div invisible='code != "gdrive"' class="w-md-50 w-lg-75 d-flex flex-column my-auto">
                                        <div>
                                            <button invisible="not access_token" name="action_setup_user_token" type="object" string="Refresh Token" class="btn btn-secondary h-100"/>
                                            <button invisible="access_token" name="action_setup_user_token" type="object" string="Setup User Token" class="btn btn-secondary h-100"/>
                                        </div>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cloud_storage_tree" model="ir.ui.view">
        <field name="name">cloud.storage.tree</field>
        <field name="model">iantirta.cloud.storage</field>
        <field name="arch" type="xml">
            <list string="Cloud Storage">
                <field name="name"/>
                <field name='code'/>
            </list>
        </field>
    </record>

    <record id="storage_storage_action" model="ir.actions.act_window">
        <field name="name">Cloud Storage</field>
        <field name="res_model">iantirta.cloud.storage</field>
        <field name="path">cloud-storage</field>
        <field name='view_mode'>list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage cloud storage
            </p>
        </field>
    </record>

    <menuitem
        id="storage_storage"
        name="Cloud Storage"
        parent="karaoke_root"
        action="storage_storage_action"
    />
</sigil>