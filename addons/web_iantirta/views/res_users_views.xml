<?xml version="1.0" encoding="utf-8"?>
<sigil>
    <record id="change_password_own_form" model="ir.ui.view">
        <field name="name">Change Own Password</field>
        <field name="model">change.password.own</field>
        <field name="arch" type="xml">
            <form position="inside">
                
            </form>
        </field>
    </record>

    <!-- res.users -->
    <record id="view_users_simple_form" model="ir.ui.view">
        <field name="name">res.users.simplified.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                
            </form>
        </field>
    </record>
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('d-flex', 'gap-3')]" position="replace">
                <div class="d-flex gap-3">
                    <div class="oe_title d-flex flex-column flex-grow-1">
                        <group>
                            <group>
                                <h5 name="h5_email" class="mb-n3 mb-sm-0">
                                    <group class="mb-0" style="margin-bottom:0 !important;">
                                        <label for="login" string="Username (login ID)"/>
                                        <div class="d-flex align-items-baseline gap-2">
                                            <i class="fa fa-fw fa-envelope text-primary" title="Login / Email" invisible="login != email"/>
                                            <i class="fa fa-fw fa-key text-primary" title="Login" invisible="login == email"/>
                                            <field name="login" placeholder="Login"/>
                                        </div>
                                        <label for="email" string="Email Address" invisible="login == email"/>
                                        <div class="d-flex align-items-baseline gap-2" invisible="login == email">
                                            <i class="fa fa-fw fa-envelope text-primary" title="Email" invisible="login == email"/>
                                            <field name="email" placeholder="Email" invisible="login == email"/>
                                        </div>
                                    </group>
                                </h5>
                            </group>
                            <group>
                                <label for="name" string="Full Name"/>
                                <h1 class="mb-0 d-flex align-items-baseline gap-2">
                                    <i class="fa fa-fw fa-user-circle-o text-primary" title="Username"/>
                                    <field name="name" placeholder="e.g. John Doe" required="1"/>
                                </h1>
                                <label for="phone" string="Phone Number"/>
                                <h5 name="h5_phone" class="d-flex align-items-baseline gap-2 mb-0">
                                    <i class="fa fa-fw fa-phone text-primary" title="Phone"/>
                                    <field name="phone" placeholder="Phone"/>
                                </h5>
                            </group>
                        </group>
                    </div>
                    <field name="image_1920" class="flex-grow-1 text-end" widget="contact_image" options="{'preview_image': 'avatar_128', 'img_class': 'rounded-4'}"/>
                    <field name="avatar_128" invisible="1"/> <!-- Needed in contact_image widget -->
                </div>
            </xpath>
            <xpath expr="//sheet/group/field[@name='partner_id']" position="attributes">
                <attribute name="string">Associated Partner</attribute>
            </xpath>
            <page name="access_rights" position="attributes">
                <attribute name="string">Roles &amp; Permission</attribute> 
            </page>
            <page name="calendar" position="attributes">
                <attribute name="string">Timezone</attribute> 
            </page>
            <page name="page_security" position="attributes">
                <attribute name="string">Security &amp; Access</attribute> 
            </page>
        </field>
    </record>

    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('d-flex', 'align-items-center')]" position="replace">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="oe_title flex-fill">
                        <group>
                            <group>
                                <label for="email" string="Email Address"/>
                                <h5 name="h5_email" class="d-flex align-items-baseline gap-2 mb-0">
                                    <i class="fa fa-fw fa-envelope text-primary" title="Email"/>
                                    <field name="email" placeholder="Email"/>
                                </h5>
                            </group>
                            <group>
                                <label for="name" string="Full Name"/>
                                <h1 class="d-flex align-items-center gap-2">
                                    <i class="fa fa-fw fa-user-circle-o text-primary" title="Username"/>
                                    <field name="name"/>
                                </h1>
                                <label for="phone" string="Phone Number"/>
                                <h5 name="h5_phone" class="d-flex align-items-baseline gap-2 mb-0">
                                    <i class="fa fa-fw fa-phone text-primary" title="Phone"/>
                                    <field name="phone" placeholder="Phone"/>
                                </h5>
                            </group>
                        </group>
                    </div>
                    <div>
                        <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128'}"/>
                        <field name="avatar_128" invisible="1"/> <!-- Needed in contact_image widget -->
                    </div>
                </div>
            </xpath>
            <page name="calendar" position="attributes">
                <attribute name="string">Timezone</attribute> 
            </page>
            <page name="page_security" position="attributes">
                <attribute name="string">Security &amp; Access</attribute> 
            </page>
        </field>
    </record>
</sigil>