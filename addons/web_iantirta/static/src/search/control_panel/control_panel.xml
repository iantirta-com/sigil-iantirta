<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_main', 'align-items-lg-start')]" position="attributes">
            <attribute name="class" add="align-items-center" remove="align-items-lg-start" separator=" "/>
        </xpath>
    </t>
</templates>
