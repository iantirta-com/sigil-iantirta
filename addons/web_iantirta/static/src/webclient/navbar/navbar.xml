<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="web.NavBar" t-inherit-mode="extension" owl="1">
        <xpath expr="//nav[contains(@class, 'o_main_navbar')]" position="replace">
            <nav class="o_main_navbar o_sigil_navbar d-print-none" data-command-category="disabled">

                <!-- App launcher -->
                <t t-call="web.NavBar.AppsMenu">
                    <t t-set="apps" t-value="menuService.getApps()" />
                </t>

                <!-- Sigil brand / current application -->
                <div class="o_sigil_navbar_brand_group">
                    <DropdownItem
                        t-if="!this.ui.isSmall and currentApp"
                        t-esc="currentApp.name"
                        class="'o_sigil_navbar_app'"
                        onSelected="() => this.onNavBarDropdownItemSelection(currentApp)"
                        attrs="{
                            href: getMenuItemHref(currentApp),
                            'data-menu-xmlid': currentApp.xmlid,
                            'data-section': currentApp.id
                        }"
                    />
                </div>

                <!-- Current application sections -->
                <t t-if="!this.ui.isSmall and currentAppSections.length" t-call="web.NavBar.SectionsMenu">
                    <t t-set="sections" t-value="currentAppSections" />
                </t>

                <!-- Flexible spacer -->
                <div class="o_sigil_navbar_spacer"/>

                <!-- Systray -->
                <div class="o_menu_systray o_sigil_navbar_systray d-flex flex-shrink-0 bg-inherit" role="menu">
                    <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                        <div t-att-data-index="item.index"/>
                        <ErrorHandler onError="error => this.handleItemError(error, item)">
                            <t t-component="item.Component" t-props="item.props"/>
                        </ErrorHandler>
                    </t>
                </div>

            </nav>
        </xpath>
    </t>

    <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[@title='Home Menu']" position="replace">
            <button
                class="o_sigil_navbar_icon_button o_sigil_app_launcher"
                data-hotkey="h"
                title="All applications"
                aria-label="All applications"
            >
                <i class="oi oi-apps"/>
            </button>
        </xpath>
    </t>

    <t t-inherit="web.NavBar.SectionsMenu" t-inherit-mode="extension" owl="1">
        <xpath expr="//DropdownGroup" position="replace">
            <DropdownGroup>
                <t t-foreach="sections" t-as="section" t-key="section.id">
                    <t t-set="sectionsVisibleCount" t-value="(sections.length - currentAppSectionsExtra.length)"/>

                    <t t-if="section_index lt Math.min(10, sectionsVisibleCount)">
                        <t t-set="hotkey" t-value="((section_index + 1) % 10).toString()"/>
                    </t>
                    <t t-else="">
                        <t t-set="hotkey" t-value="undefined"/>
                    </t>

                    <!-- Direct section -->
                    <t t-if="!section.childrenTree.length">
                        <DropdownItem
                            class="'o_sigil_navbar_section'"
                            onSelected="() => this.onNavBarDropdownItemSelection(section)"
                            t-esc="section.name"
                            attrs="{
                                href: getMenuItemHref(section),
                                'data-hotkey': hotkey,
                                'data-menu-xmlid': section.xmlid,
                                'data-section': section.id
                            }"
                        />
                    </t>

                    <!-- Section with children -->
                    <t t-else="">
                        <Dropdown>
                            <button
                                class="o_sigil_navbar_section o_sigil_navbar_section_dropdown"
                                t-att-data-hotkey="hotkey"
                                t-att-data-menu-xmlid="section.xmlid"
                            >
                                <span t-esc="section.name" t-att-data-section="section.id"/>
                                <i class="fa fa-angle-down o_sigil_navbar_section_chevron"/>
                            </button>

                            <t t-set-slot="content">
                                <t t-call="web.NavBar.SectionsMenu.Dropdown.MenuSlot">
                                    <t t-set="items" t-value="section.childrenTree"/>
                                    <t t-set="decalage" t-value="20"/>
                                </t>
                            </t>
                        </Dropdown>
                    </t>
                </t>

                <!-- More -->
                <t t-if="currentAppSectionsExtra.length" t-call="web.NavBar.SectionsMenu.MoreDropdown">
                    <t t-set="sections" t-value="currentAppSectionsExtra"/>
                    <t t-if="sectionsVisibleCount lt 10">
                        <t t-set="hotkey" t-value="(sectionsVisibleCount + 1 % 10).toString()"/>
                    </t>
                </t>
            </DropdownGroup>
        </xpath>
    </t>


    <t t-inherit="web.NavBar.SectionsMenu.MoreDropdown" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[@title='More Menu']" position="replace">
            <button
                class="o_sigil_navbar_icon_button o_sigil_navbar_more_button"
                title="More"
                t-att-data-hotkey="hotkey"
                aria-label="More navigation"
            >
                <i class="fa fa-ellipsis-h"/>
            </button>
        </xpath>
    </t>


    <t t-inherit="web.NavBar.AppsMenu.Sidebar" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class, 'o_app_menu_sidebar')]" position="attributes">
            <attribute name="class">o_app_menu_sidebar o_sigil_mobile_drawer position-fixed top-0 bottom-0 end-100 d-flex flex-column flex-nowrap</attribute>
        </xpath>

        <xpath expr="//a[contains(@class, 'btn-primary')]" position="attributes">
            <attribute name="class">o_sigil_mobile_all_apps_button</attribute>
        </xpath>

        <xpath expr="//button[contains(@class, 'o_sidebar_close')]" position="attributes">
            <attribute name="class">o_sidebar_close o_sigil_mobile_close_button d-flex align-items-center justify-content-center border-0 bg-transparent</attribute>
        </xpath>

        <xpath expr="//nav[contains(@class, 'o_burger_menu_content')]" position="attributes">
            <attribute name="class">o_burger_menu_content o_sigil_mobile_menu_content flex-grow-1 flex-shrink-1 overflow-auto</attribute>
        </xpath>

        <xpath expr="//div[contains(@class, 'm-3') and contains(@class, 'mb-0')]" position="attributes">
            <attribute name="class">o_sigil_mobile_current_app</attribute>
        </xpath>

        <xpath expr="//span[contains(@class, 'fs-4') and contains(@class, 'fw-bolder')]" position="attributes">
            <attribute name="class">o_sigil_mobile_current_app_name</attribute>
        </xpath>
    </t>

    <t t-inherit="web.SectionMenu" t-inherit-mode="extension" owl="1">
        <xpath expr="//li[1]" position="attributes">
            <attribute name="class">px-3 o_sigil_mobile_menu_group</attribute>
        </xpath>

        <xpath expr="//li[1]/div" position="attributes">
            <attribute name="class">o_sigil_mobile_menu_group_title</attribute>
        </xpath>

        <xpath expr="//li[@t-else='']" position="attributes">
            <attribute name="class">o_sigil_mobile_menu_item</attribute>
        </xpath>
    </t>
</templates>