<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.FormUrlField" t-inherit-mode="extension">
        <xpath expr="//i[hasclass('fa-globe')]" position="attributes">
            <attribute name="class" add="fa-fw fa-external-link" remove="fa-globe" separator=" "/>
        </xpath>
        <xpath expr="//a[@t-if='props.record.data[props.name]']" position="attributes">
            <attribute name="class" add="ms-2 me-1" remove="ms-3" separator=" "/>
        </xpath>
    </t>
</templates>