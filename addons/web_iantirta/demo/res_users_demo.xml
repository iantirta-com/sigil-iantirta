<?xml version="1.0" encoding="utf-8"?>
<sigil>
    <data noupdate="1">

        <record id="base.partner_demo" model="res.partner">
            <field name="name">Budi Santoso</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_name">Iantirta Labs</field>
            <field name="street">Jl. Kemang Raya No. 25</field>
            <field name="city">Jakarta Selatan</field>
            <field name="state_id" model="res.country.state" search="[('code','=','JK')]"/>
            <field name="zip">12730</field>
            <field name="country_id" ref="base.id"/>
            <field name="tz">Asia/Jakarta</field>
            <field name="email">budi.santoso@example.id</field>
            <field name="phone">+62 812-3456-7890</field>
        </record>

        <!-- Only update if we don't have information coming from the database manager -->
        <function model="res.partner" name="write">
            <value eval="[ref('base.main_partner')]"/>
            <value eval="{
                'name': 'Iantirta Labs',
                'street': 'Jl. Jenderal Sudirman No. 45',
                'city': 'Jakarta Selatan',
                'zip': '12190',
                'country_id': ref('base.id'),
                'state_id': ref('base.state_id_1'),
                'phone': '+62 21 5555 1234',
                'website': 'www.iantirta.com',
                'email': 'info@iantirta.com',
            } if obj(ref('base.main_partner')).name == 'My Company' else {}" model="res.partner"/>
        </function>

        <record id="base.user_demo" model="res.users">
            <field name="partner_id" ref="base.partner_demo"/>
            <field name="login">demo</field>
            <field name="password">demo</field>
            <field name="signature" type="html"><div>Budi Santoso</div></field>
            <field name="company_id" ref="base.main_company"/>
            <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('base.group_partner_manager'), ref('base.group_allow_export')])]"/>
            <field name="image_1920" type="base64" file="base/static/img/user_demo-image.png"/>
        </record>

        <record id="base.partner_demo" model="res.partner">
            <field name="user_id" ref="base.user_demo"/>
        </record>

        <record model="res.partner" id="base.partner_root">
            <field name="tz">Asia/Jakarta</field>
        </record>

        <record model="res.partner" id="base.partner_admin">
            <field name="name">Andi Pratama</field>
            <field name="company_name">PT Nusantara Teknologi Indonesia</field>
            <field name="street">Jl. Gatot Subroto No. 88</field>
            <field name="city">Jakarta Selatan</field>
            <field name="zip">12930</field>
            <field name="country_id" ref="base.id"/>
            <field name="state_id" model="res.country.state" search="[('code','=','JK')]"/>
            <field name="phone">+62 811-2233-4455</field>
            <field name="email">admin@nusantarateknologi.id</field>
            <field name="tz">Asia/Jakarta</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="image_1920" type="base64" file="base/static/img/partner_root-image.png"/>
        </record>

        <record id="base.user_admin" model="res.users">
            <field name="signature" type="html"><div>Andi Pratama</div></field>
        </record>

        <!-- Portal : partner and user -->
        <record id="base.partner_demo_portal" model="res.partner">
            <field name="name">Rina Maharani</field>
            <field name="email">rina.maharani@example.id</field>
            <field name="street">Jl. Diponegoro No. 17</field>
            <field name="city">Bandung</field>
            <field model="res.country.state" name="state_id" search="[('code','=','JB')]"/>
            <field name="zip">40115</field>
            <field name="country_id" ref="base.id"/>
            <field name="company_name">PT Nusantara Teknologi Indonesia</field>
            <field name="image_1920" type="base64" file="base/static/img/partner_demo_portal.png"/>
            <field name="phone">+62 813-6677-8899</field>
        </record>

        <record id="base.demo_user0" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="base.partner_demo_portal"/>
            <field name="login">portal</field>
            <field name="password">portal</field>
            <field name="signature" type="html"><div>Rina Maharani</div></field>
            <field name="group_ids" eval="[Command.clear()]"/>
        </record>

        <record id="base.group_portal" model="res.groups">
            <field name="user_ids" eval="[Command.link(ref('base.demo_user0'))]"/>
        </record>
    </data>
</sigil>